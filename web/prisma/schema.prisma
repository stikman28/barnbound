// BarnBound — Prisma schema (PostgreSQL)
// Money is stored as integer cents (priceCents / offerCents) to avoid float errors.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  RIDER
  TRAINER
  BARN_OWNER
  MERCHANT
  ADMIN
}

enum ListingType {
  HORSE
  TACK
  EQUIPMENT
  TRAILER
  CLOTHING
  OTHER
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum OrderStatus {
  REQUESTED
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  location     String?
  role         Role       @default(RIDER)
  createdAt    DateTime   @default(now())

  // Email verification (Tier 1 security): 6-digit code, short-lived.
  // Unverified accounts can browse but not list, sell, buy, or message.
  emailVerified    DateTime?
  verifyCode       String?
  verifyCodeExpiry DateTime?

  listings     Listing[]
  orders       Order[]
  inquiries    Inquiry[]
  favorites    Favorite[]

  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messages            Message[]

  groupsCreated    Group[]           @relation("GroupCreator")
  groupMemberships GroupMembership[]
  threads          Thread[]
  replies          Reply[]
  eventsCreated    Event[]           @relation("EventCreator")
  eventRsvps       EventRsvp[]
  businesses       Business[]        @relation("BusinessOwner")

  products       Product[]       @relation("ProductSeller")
  cartItems      CartItem[]
  shopOrders     ShopOrder[]     @relation("ShopBuyer")
  shopOrderItems ShopOrderItem[] @relation("ShopItemSeller")
  claimRequests  BusinessClaimRequest[]
}

// Claiming a directory business requires admin approval (Tier 1 security) —
// instant first-come claims were an impersonation/defacement vector.
enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model BusinessClaimRequest {
  id        String      @id @default(cuid())
  proof     String // how the claimant proves ownership (site, email domain, phone…)
  status    ClaimStatus @default(PENDING)
  createdAt DateTime    @default(now())

  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String

  @@unique([businessId, userId])
  @@index([status])
}

enum BusinessPlan {
  FREE
  STARTER
  PRO
  PREMIER
}

model Business {
  id           Int      @id @default(autoincrement())
  name         String
  url          String?
  category     String
  city         String
  lat          Float?
  lng          Float?
  image        String?
  emoji        String?
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  tags         String[]
  verified     Boolean  @default(false)
  featured     Boolean  @default(false)
  description  String
  plan         BusinessPlan @default(FREE)
  createdAt    DateTime @default(now())

  owner        User?    @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId      String?

  claimRequests BusinessClaimRequest[]

  @@index([ownerId])
}

model Listing {
  id          String        @id @default(cuid())
  type        ListingType
  title       String
  priceCents  Int
  city        String
  description String        @default("")
  emoji       String        @default("📦")
  breed       String?
  discipline  String?
  age         Int?
  category    String?
  verified    Boolean       @default(false)
  featured    Boolean       @default(false)
  status      ListingStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())

  seller      User          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId    String

  orders        Order[]
  inquiries     Inquiry[]
  favorites     Favorite[]
  conversations Conversation[]

  @@index([type])
  @@index([sellerId])
}

model Order {
  id         String      @id @default(cuid())
  offerCents Int
  message    String?
  status     OrderStatus @default(REQUESTED)
  createdAt  DateTime    @default(now())

  listing    Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  buyer      User        @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId    String

  @@index([buyerId])
  @@index([listingId])
}

model Inquiry {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId   String

  @@index([buyerId])
  @@index([listingId])
}

model Favorite {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([userId, listingId])
  @@index([userId])
}

model Conversation {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId   String
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId  String

  messages  Message[]

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  body           String
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String

  @@index([conversationId])
}

// ---------- Shop (Phase 4 — drop-ship commerce) ----------
// New-goods catalog sold by merchants and drop-shipped to buyers. Distinct
// from Listing (used-goods classifieds with offers). PayPal is stubbed until
// the account exists: checkout marks orders PAID with a STUB payment ref.

enum ProductStatus {
  ACTIVE
  ARCHIVED
}

enum ShopOrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum FulfillmentStatus {
  NEW
  SHIPPED
  DELIVERED
}

model Product {
  id            String        @id @default(cuid())
  name          String
  description   String        @default("")
  priceCents    Int
  shippingCents Int           @default(0)
  emoji         String        @default("🛍️")
  category      String
  brand         String?
  inventory     Int           @default(0)
  pick          Boolean       @default(false) // BarnBound Picks — admin-curated
  status        ProductStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())

  seller   User   @relation("ProductSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String

  cartItems  CartItem[]
  orderItems ShopOrderItem[]

  @@index([sellerId])
  @@index([category])
}

model CartItem {
  id        String   @id @default(cuid())
  qty       Int
  createdAt DateTime @default(now())

  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@unique([userId, productId])
  @@index([userId])
}

model ShopOrder {
  id              String          @id @default(cuid())
  subtotalCents   Int
  shippingCents   Int
  totalCents      Int
  commissionCents Int // platform cut (basis for future seller payouts)
  status          ShopOrderStatus @default(PENDING)
  paymentProvider String          @default("PAYPAL_STUB")
  paymentRef      String?
  shipName        String
  shipAddress     String
  shipCity        String
  shipState       String
  shipZip         String
  createdAt       DateTime        @default(now())

  buyer   User   @relation("ShopBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  buyerId String

  items ShopOrderItem[]

  @@index([buyerId])
}

// One row per product in an order, routed to that product's seller for
// drop-ship fulfillment. Snapshots survive product edits/deletion.
model ShopOrderItem {
  id                String            @id @default(cuid())
  nameSnapshot      String
  priceCentsSnap    Int
  qty               Int
  commissionCents   Int
  fulfillmentStatus FulfillmentStatus @default(NEW)
  createdAt         DateTime          @default(now())

  order     ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  seller    User      @relation("ShopItemSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId  String

  @@index([orderId])
  @@index([sellerId])
}

// ---------- Community ----------

model Group {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String   @default("👥")
  createdAt   DateTime @default(now())

  createdBy   User?    @relation("GroupCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  memberships GroupMembership[]
}

model GroupMembership {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([groupId, userId])
  @@index([userId])
}

model Thread {
  id        String   @id @default(cuid())
  title     String
  category  String
  icon      String   @default("💬")
  body      String   @default("")
  createdAt DateTime @default(now())

  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  replies   Reply[]

  @@index([authorId])
}

model Reply {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  threadId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String

  @@index([threadId])
}

model Event {
  id          String    @id @default(cuid())
  title       String
  startsAt    DateTime
  location    String?
  details     String?
  category    String    @default("Community")
  createdAt   DateTime  @default(now())

  createdBy   User?     @relation("EventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById String?

  rsvps       EventRsvp[]

  @@index([startsAt])
}

model EventRsvp {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  @@unique([eventId, userId])
  @@index([userId])
}
