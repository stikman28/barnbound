# Copy to .env for local (host-run) Prisma commands.
# docker-compose sets DATABASE_URL itself (pointing at the db service).
DATABASE_URL="postgresql://barnbound:barnbound@localhost:5433/barnbound?schema=public"

# Secret used to sign session JWTs. Generate a strong one for any real deploy:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="dev-only-insecure-secret-change-me"
