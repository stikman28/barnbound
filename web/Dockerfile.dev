# Development image for the BarnBound web app (Next.js 16).
# Source is bind-mounted by docker-compose; this image just provides
# Node + an installed node_modules layer. Prisma client (engine-less,
# pure TS) and migrations are generated/applied at container start.
FROM node:26-slim

# Prisma CLI (generate/migrate) probes for OpenSSL; install it to keep logs clean.
RUN apt-get update -y && apt-get install -y --no-install-recommends openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies first for better layer caching.
COPY package.json package-lock.json ./
RUN npm ci

EXPOSE 3000

# Default command is overridden by docker-compose, but kept sensible.
CMD ["npm", "run", "dev"]
